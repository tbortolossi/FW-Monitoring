{#
  inputs_paloalto.tmpl - Palo Alto SNMP inputs (plain Jinja2).

  Polling layout: every Palo Alto firewall gets TWO [[inputs.snmp]] instances
  that share the same agent, credentials and [inputs.snmp.tags].

  1. Fast instance, agent interval (20s), measurement name "pan_system":
     pan_system scalars (one GET per request of up to 60 OIDs), interfaces,
     pan_hr_processors, vsys, pan_zones, pan_interfaces_cps (PAN-OS 10.2+)
     and pan_interface_utilization (PAN-OS 12.1+). This is the capacity/load
     data the dashboards read: CPU, RAM, sessions, CPS, interface counters.

  2. Slow instance, interval = "60s", measurement name "pan_global_counters":
     the PAN-OS global counters are scalars (.0), so they are top-level
     [[inputs.snmp.field]] entries fetched with a couple of GET requests
     instead of one SNMP walk per counter (~93 walks every 20s before). The
     instance name is what keeps them in the "pan_global_counters"
     measurement, which is why pan_system scalars stay in the fast instance.
     The same instance also walks the slow-moving tables: pan_hr_storage,
     pan_hr_devices, pan_pa_cluster and, in chassis mode, the ENTITY,
     ENTITY-SENSOR, ENTITY-STATE and PAN-ENTITY-EXT tables.

  Both instances use max_repetitions = 25 so each GETBULK round trip returns
  more table rows. Measurement, field and tag names are part of the dashboard
  contract: keep them unchanged. Every measurement carries the "hostname" tag
  (sysName.0 in each instance, inherited by tables through inherit_tags).
#}
{% macro snmp_agent(fw) %}
  agents = ["udp://{{ fw.host }}:161"]
  version = {{ fw.snmp_version }}
  agent_host_tag = "source"
  {% if fw.get('snmp_version') == 2 %}
  community = "{{ fw.community }}"
  {% elif fw.get('snmp_version') == 3 %}
  sec_name = "{{ fw.username }}"
  auth_protocol = "{{ fw.telegraf_auth_protocol }}"
  auth_password = "{{ fw.auth_password }}"
  priv_protocol = "{{ fw.telegraf_priv_protocol }}"
  priv_password = "{{ fw.priv_password }}"
  sec_level = "authPriv"
  {% endif %}
{%- endmacro %}
{% macro snmp_tags(fw) %}
  [inputs.snmp.tags]
    vendor = "paloalto"
    {% if fw.get('cluster') %}
    cluster = "{{ fw.cluster }}"
    {% endif %}
    {% if fw.get('model') %}
    model = "{{ fw.model }}"
    {% endif %}
    {% if fw.get('chassis_model') %}
    chassis_model = "{{ fw.chassis_model }}"
    {% endif %}
    {% if fw.get('chassis_family') %}
    chassis_family = "{{ fw.chassis_family }}"
    {% endif %}

  [[inputs.snmp.field]]
    oid    = "RFC1213-MIB::sysName.0"
    name   = "hostname"
    is_tag = true
{%- endmacro %}
{% for fw in firewalls %}
{% if fw.get('vendor', 'paloalto') == 'paloalto' %}
###############################################################################
# {{ fw.hostname }} ({{ fw.host }}) - Palo Alto - fast polling (agent interval)
###############################################################################
[[inputs.snmp]]
{{ snmp_agent(fw) }}
  name = "pan_system"
  timeout = "5s"
  retries = 3
  max_repetitions = 25

{{ snmp_tags(fw) }}

  [[inputs.snmp.field]]
    oid  = "RFC1213-MIB::sysDescr.0"
    name = "system_description"

  [[inputs.snmp.field]]
    oid  = "RFC1213-MIB::sysObjectID.0"
    name = "system_object_id"

  [[inputs.snmp.field]]
    oid  = "RFC1213-MIB::sysUpTime.0"
    name = "uptime"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSysSwVersion.0"
    name = "panos_version"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSysHwVersion.0"
    name = "hw_version"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSysSerialNumber.0"
    name = "serial_number"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSysHAState.0"
    name = "ha_state"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSysHAPeerState.0"
    name = "ha_peer_state"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSysHAMode.0"
    name = "ha_mode"

  [[inputs.snmp.field]]
    oid  = "HOST-RESOURCES-MIB::hrProcessorLoad.1"
    name = "mp_cpu_pct"

  [[inputs.snmp.field]]
    oid  = "HOST-RESOURCES-MIB::hrProcessorLoad.2"
    name = "dp_cpu_pct"

  [[inputs.snmp.field]]
    oid  = "HOST-RESOURCES-MIB::hrStorageSize.1020"
    name = "ram_total_kb"

  [[inputs.snmp.field]]
    oid  = "HOST-RESOURCES-MIB::hrStorageUsed.1020"
    name = "ram_used_kb"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSessionActive.0"
    name = "sessions_active"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSessionUtilization.0"
    name = "session_utilization_pct"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSessionMax.0"
    name = "sessions_max"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSessionActiveTcp.0"
    name = "sessions_active_tcp"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSessionActiveUdp.0"
    name = "sessions_active_udp"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSessionActiveICMP.0"
    name = "sessions_active_icmp"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panSessionCps.0"
    name = "session_cps"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panGPGWUtilizationPct.0"
    name = "gp_gateway_utilization_pct"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panGPGWUtilizationMaxTunnels.0"
    name = "gp_gateway_max_tunnels"

  [[inputs.snmp.field]]
    oid  = "PAN-COMMON-MIB::panGPGWUtilizationActiveTunnels.0"
    name = "gp_gateway_active_tunnels"
  {% if fw.get('chassis') and fw.get('pan_entity_ext') %}

  # PAN-ENTITY-EXT-MIB is documented for PA-7000 Series and PA-5450.
  # Chassis power totals are scalars and stay in the pan_system measurement;
  # the per-module PAN-ENTITY-EXT tables are polled by the slow instance.
  [[inputs.snmp.field]]
    oid  = "PAN-ENTITY-EXT-MIB::panEntityTotalPowerAvail.0"
    name = "power_available_watts"

  [[inputs.snmp.field]]
    oid  = "PAN-ENTITY-EXT-MIB::panEntityTotalPowerUsed.0"
    name = "power_used_watts"
  {% endif %}

  [[inputs.snmp.table]]
    name         = "interfaces"
    inherit_tags = ["hostname"]
    oid          = "IF-MIB::ifXTable"

    # Global throughput should be calculated from interface octet
    # counters because offloaded traffic may bypass dataplane counters.
    # Counter64 values are returned as unsigned integers without any
    # conversion option.
    [[inputs.snmp.table.field]]
      oid    = "IF-MIB::ifName"
      name   = "ifName"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid    = "IF-MIB::ifDescr"
      name   = "ifDescr"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid    = "IF-MIB::ifType"
      name   = "ifType"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid    = "IF-MIB::ifConnectorPresent"
      name   = "ifConnectorPresent"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifAlias"
      name = "ifAlias"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifAdminStatus"
      name = "ifAdminStatus"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifOperStatus"
      name = "ifOperStatus"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHighSpeed"
      name = "ifHighSpeed"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifMtu"
      name = "ifMtu"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHCInOctets"
      name = "ifHCInOctets"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHCOutOctets"
      name = "ifHCOutOctets"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHCInUcastPkts"
      name = "ifHCInUcastPkts"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHCOutUcastPkts"
      name = "ifHCOutUcastPkts"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHCInMulticastPkts"
      name = "ifHCInMulticastPkts"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHCOutMulticastPkts"
      name = "ifHCOutMulticastPkts"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHCInBroadcastPkts"
      name = "ifHCInBroadcastPkts"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifHCOutBroadcastPkts"
      name = "ifHCOutBroadcastPkts"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifInErrors"
      name = "ifInErrors"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifOutErrors"
      name = "ifOutErrors"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifInDiscards"
      name = "ifInDiscards"

    [[inputs.snmp.table.field]]
      oid  = "IF-MIB::ifOutDiscards"
      name = "ifOutDiscards"

  [[inputs.snmp.table]]
    name         = "pan_hr_processors"
    inherit_tags = ["hostname"]
    oid          = "HOST-RESOURCES-MIB::hrProcessorTable"
    # Both tags carry the hrDeviceIndex of each processor: "index" comes
    # from index_as_tag and "device_index" from the explicit field below.
    # They are kept together because existing dashboards may use either.
    index_as_tag = true

    [[inputs.snmp.table.field]]
      oid    = "HOST-RESOURCES-MIB::hrDeviceIndex"
      name   = "device_index"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "HOST-RESOURCES-MIB::hrProcessorLoad"
      name = "processor_load_pct"

  # The vsys table is always polled, even when no multi-vsys configuration
  # was detected (vsys_detected): single-vsys firewalls still return vsys1,
  # which gives the dashboards a consistent per-vsys sessions/CPS view.
  [[inputs.snmp.table]]
    name = "vsys"
    oid = "PAN-COMMON-MIB::panVsysTable"
    inherit_tags = ["hostname"]

    [[inputs.snmp.table.field]]
      name = "vsys_id"
      oid = "PAN-COMMON-MIB::panVsysId"
      is_tag = true

    [[inputs.snmp.table.field]]
      name = "vsys_name"
      oid = "PAN-COMMON-MIB::panVsysName"
      is_tag = true

    [[inputs.snmp.table.field]]
      name = "active_sessions"
      oid = "PAN-COMMON-MIB::panVsysActiveSessions"

    [[inputs.snmp.table.field]]
      name = "max_sessions"
      oid = "PAN-COMMON-MIB::panVsysMaxSessions"

    [[inputs.snmp.table.field]]
      name = "session_utilization_pct"
      oid = "PAN-COMMON-MIB::panVsysSessionUtilizationPct"

    [[inputs.snmp.table.field]]
      name = "tcp_cps"
      oid = "PAN-COMMON-MIB::panVsysActiveTcpCps"

    [[inputs.snmp.table.field]]
      name = "udp_cps"
      oid = "PAN-COMMON-MIB::panVsysActiveUdpCps"

    [[inputs.snmp.table.field]]
      name = "other_ip_cps"
      oid = "PAN-COMMON-MIB::panVsysActiveOtherIpCps"
    {% if fw.get('vsys_total_cps') and fw.get('panos_12_metrics') %}

    [[inputs.snmp.table.field]]
      name = "total_cps"
      oid = "PAN-COMMON-MIB::panVsysTotalCps"
    {% endif %}

  [[inputs.snmp.table]]
    name         = "pan_zones"
    inherit_tags = ["hostname"]
    oid          = "PAN-COMMON-MIB::panZoneTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      oid    = "PAN-COMMON-MIB::panZoneName"
      name   = "zone"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "PAN-COMMON-MIB::panZoneActiveTcpCps"
      name = "tcp_cps"

    [[inputs.snmp.table.field]]
      oid  = "PAN-COMMON-MIB::panZoneActiveUdpCps"
      name = "udp_cps"

    [[inputs.snmp.table.field]]
      oid  = "PAN-COMMON-MIB::panZoneActiveOtherIpCps"
      name = "other_ip_cps"
  {% if fw.get('panos_10_2_metrics') %}

  # PAN-OS 10.2+ per-interface CPS (panIfTable).
  [[inputs.snmp.table]]
    name         = "pan_interfaces_cps"
    inherit_tags = ["hostname"]
    oid          = "PAN-COMMON-MIB::panIfTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      name   = "ifDescr"
      oid    = "PAN-COMMON-MIB::panIfDescr"
      is_tag = true

    [[inputs.snmp.table.field]]
      name = "tcp_cps"
      oid  = "PAN-COMMON-MIB::panIfActiveTcpCps"

    [[inputs.snmp.table.field]]
      name = "udp_cps"
      oid  = "PAN-COMMON-MIB::panIfActiveUdpCps"

    [[inputs.snmp.table.field]]
      name = "other_ip_cps"
      oid  = "PAN-COMMON-MIB::panIfActiveOtherIpCps"
  {% endif %}
  {% if fw.get('interface_utilization') %}

  # PAN-OS 12.1+ native interface utilization in bytes/s and packets/s.
  # For cross-version dashboards, IF-MIB counters remain the source of
  # truth because they are available on older PAN-OS releases too.
  [[inputs.snmp.table]]
    name         = "pan_interface_utilization"
    inherit_tags = ["hostname"]
    oid          = "PAN-COMMON-MIB::panInterfaceUtilizationTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      name = "if_index"
      oid  = "PAN-COMMON-MIB::ifIndexRef"

    [[inputs.snmp.table.field]]
      name   = "ifName"
      oid    = "PAN-COMMON-MIB::ifName"
      is_tag = true

    [[inputs.snmp.table.field]]
      name = "in_bytes_per_sec"
      oid  = "PAN-COMMON-MIB::ifHCInOctetsUtilization"

    [[inputs.snmp.table.field]]
      name = "out_bytes_per_sec"
      oid  = "PAN-COMMON-MIB::ifHCOutOctetsUtilization"

    [[inputs.snmp.table.field]]
      name = "in_unicast_pkts_per_sec"
      oid  = "PAN-COMMON-MIB::ifHCInUcastPktsUtilization"

    [[inputs.snmp.table.field]]
      name = "out_unicast_pkts_per_sec"
      oid  = "PAN-COMMON-MIB::ifHCOutUcastPktsUtilization"
  {% endif %}

###############################################################################
# {{ fw.hostname }} ({{ fw.host }}) - Palo Alto - slow polling (60s)
###############################################################################
[[inputs.snmp]]
{{ snmp_agent(fw) }}
  name = "pan_global_counters"
  interval = "60s"
  timeout = "5s"
  retries = 2
  max_repetitions = 25

{{ snmp_tags(fw) }}

  # A small useful subset of PAN-OS global counters, fetched with GET.
  # These are not used for throughput; throughput should come from
  # interface octet counters because offloaded traffic may bypass DP counters.
  [[inputs.snmp.field]]
    name = "panFlowIpfragFragErr"
    oid  = "PAN-COMMON-MIB::panFlowIpfragFragErr.0"

  [[inputs.snmp.field]]
    name = "panFlowIpfragRecv"
    oid  = "PAN-COMMON-MIB::panFlowIpfragRecv.0"

  [[inputs.snmp.field]]
