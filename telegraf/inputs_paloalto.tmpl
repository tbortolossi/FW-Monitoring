    name         = "pan_hr_storage"
    inherit_tags = ["hostname"]
    oid          = "HOST-RESOURCES-MIB::hrStorageTable"

    [[inputs.snmp.table.field]]
      oid    = "HOST-RESOURCES-MIB::hrStorageIndex"
      name   = "storage_index"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid    = "HOST-RESOURCES-MIB::hrStorageDescr"
      name   = "storage_descr"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "HOST-RESOURCES-MIB::hrStorageAllocationUnits"
      name = "allocation_units"

    [[inputs.snmp.table.field]]
      oid  = "HOST-RESOURCES-MIB::hrStorageSize"
      name = "storage_size"

    [[inputs.snmp.table.field]]
      oid  = "HOST-RESOURCES-MIB::hrStorageUsed"
      name = "storage_used"
    {% if fw.get('panos_11_2_metrics') %}

    # PAN-OS 11.2+ storage usage percentage.
    [[inputs.snmp.table.field]]
      oid  = "PAN-COMMON-MIB::panhrStorageUsage"
      name = "storage_usage_pct"
    {% endif %}

  [[inputs.snmp.table]]
    name         = "pan_hr_devices"
    inherit_tags = ["hostname"]
    oid          = "HOST-RESOURCES-MIB::hrDeviceTable"

    [[inputs.snmp.table.field]]
      oid    = "HOST-RESOURCES-MIB::hrDeviceIndex"
      name   = "device_index"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid    = "HOST-RESOURCES-MIB::hrDeviceDescr"
      name   = "device_descr"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "HOST-RESOURCES-MIB::hrDeviceStatus"
      name = "device_status"

    [[inputs.snmp.table.field]]
      oid  = "HOST-RESOURCES-MIB::hrDeviceErrors"
      name = "device_errors"
  {% if fw.get('pa_cluster') %}

  # PAN-OS 11.2+ PA cluster summary/utilization objects. Opt-in with
  # pa_cluster: true because some PAN-OS releases stall snmpd on them.
  # These columns span several tables that share the node index, so the
  # table has no single oid and each column is walked separately.
  # Keep interface counters as the primary source for throughput.
  [[inputs.snmp.table]]
    name         = "pan_pa_cluster"
    inherit_tags = ["hostname"]

    [[inputs.snmp.table.field]]
      name = "node_id"
      oid  = "PAN-COMMON-MIB::panPAClusterSummaryEntryNodeid"

    [[inputs.snmp.table.field]]
      name   = "mode"
      oid    = "PAN-COMMON-MIB::panPAClusterSummaryEntrymode"
      is_tag = true

    [[inputs.snmp.table.field]]
      name   = "serial_number"
      oid    = "PAN-COMMON-MIB::panPAClusterSummaryEntrySerialNumber"
      is_tag = true

    [[inputs.snmp.table.field]]
      name = "node_status"
      oid  = "PAN-COMMON-MIB::panPAClusterSummaryEntrynodeStatus"

    [[inputs.snmp.table.field]]
      name = "reported_throughput"
      oid  = "PAN-COMMON-MIB::panPAClusterUtilizationEntrythroughput"

    [[inputs.snmp.table.field]]
      name = "reported_cps"
      oid  = "PAN-COMMON-MIB::panPAClusterUtilizationEntryconnPerSec"

    [[inputs.snmp.table.field]]
      name = "reported_sessions"
      oid  = "PAN-COMMON-MIB::panPAClusterUtilizationEntrysessions"

    [[inputs.snmp.table.field]]
      name = "reported_lps"
      oid  = "PAN-COMMON-MIB::panPAClusterUtilizationEntryLPS"

    [[inputs.snmp.table.field]]
      name = "local_sessions_active"
      oid  = "PAN-COMMON-MIB::panPAClusterLocalSessStatsEntryActive"

    [[inputs.snmp.table.field]]
      name = "local_sessions_max"
      oid  = "PAN-COMMON-MIB::panPAClusterLocalSessStatsEntryMax"
  {% endif %}
  {% if fw.get('chassis') %}

  # Optional Palo Alto chassis profile.
  # Uses tables instead of fixed slot OIDs so multi-blade models can expose
  # their own processor, storage, physical entity, and sensor indexes.
  [[inputs.snmp.table]]
    name         = "pan_entity_physical"
    inherit_tags = ["hostname"]
    oid          = "ENTITY-MIB::entPhysicalTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      oid    = "ENTITY-MIB::entPhysicalIndex"
      name   = "entity_index"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-MIB::entPhysicalContainedIn"
      name = "contained_in"

    [[inputs.snmp.table.field]]
      oid    = "ENTITY-MIB::entPhysicalName"
      name   = "entity_name"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid    = "ENTITY-MIB::entPhysicalDescr"
      name   = "entity_descr"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-MIB::entPhysicalClass"
      name = "entity_class"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-MIB::entPhysicalParentRelPos"
      name = "parent_rel_pos"

    [[inputs.snmp.table.field]]
      oid    = "ENTITY-MIB::entPhysicalModelName"
      name   = "model_name"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid    = "ENTITY-MIB::entPhysicalSerialNum"
      name   = "serial_number"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-MIB::entPhysicalIsFRU"
      name = "is_fru"

  # entPhySensorTable and entStateTable are indexed by entPhysicalIndex, so
  # the entPhysicalName column joins on the same row index and labels each
  # sensor/state row with a readable "entity_name" tag. Entities without a
  # sensor/state row only get tags and no fields, so Telegraf drops them.
  [[inputs.snmp.table]]
    name         = "pan_entity_sensors"
    inherit_tags = ["hostname"]
    oid          = "ENTITY-SENSOR-MIB::entPhySensorTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      oid    = "ENTITY-MIB::entPhysicalName"
      name   = "entity_name"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid    = "ENTITY-SENSOR-MIB::entPhySensorValue"
      name   = "sensor_value"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-SENSOR-MIB::entPhySensorType"
      name = "sensor_type"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-SENSOR-MIB::entPhySensorScale"
      name = "sensor_scale"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-SENSOR-MIB::entPhySensorPrecision"
      name = "sensor_precision"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-SENSOR-MIB::entPhySensorOperStatus"
      name = "sensor_status"

  [[inputs.snmp.table]]
    name         = "pan_entity_states"
    inherit_tags = ["hostname"]
    oid          = "ENTITY-STATE-MIB::entStateTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      oid    = "ENTITY-MIB::entPhysicalName"
      name   = "entity_name"
      is_tag = true

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-STATE-MIB::entStateAdmin"
      name = "admin_state"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-STATE-MIB::entStateOper"
      name = "oper_state"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-STATE-MIB::entStateUsage"
      name = "usage_state"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-STATE-MIB::entStateAlarm"
      name = "alarm_state"

    [[inputs.snmp.table.field]]
      oid  = "ENTITY-STATE-MIB::entStateStandby"
      name = "standby_state"
    {% if fw.get('pan_entity_ext') %}

  # PAN-ENTITY-EXT-MIB is documented for PA-7000 Series and PA-5450.
  # It exposes power usage/capacity for FRU modules, fan trays, and PSUs.
  [[inputs.snmp.table]]
    name         = "pan_entity_fru_modules"
    inherit_tags = ["hostname"]
    oid          = "PAN-ENTITY-EXT-MIB::panEntityFRUModuleTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      oid  = "PAN-ENTITY-EXT-MIB::panEntryFRUModulePowerUsed"
      name = "power_used_watts"

    [[inputs.snmp.table.field]]
      oid  = "PAN-ENTITY-EXT-MIB::panEntryFRUModuleNumPorts"
      name = "num_ports"

  [[inputs.snmp.table]]
    name         = "pan_entity_fan_trays"
    inherit_tags = ["hostname"]
    oid          = "PAN-ENTITY-EXT-MIB::panEntityFanTrayTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      oid  = "PAN-ENTITY-EXT-MIB::panEntryFanTrayPowerUsed"
      name = "power_used_watts"

  [[inputs.snmp.table]]
    name         = "pan_entity_power_supplies"
    inherit_tags = ["hostname"]
    oid          = "PAN-ENTITY-EXT-MIB::panEntityPowerSupplyTable"
    index_as_tag = true

    [[inputs.snmp.table.field]]
      oid  = "PAN-ENTITY-EXT-MIB::panEntryPowerSupplyPowerCapacity"
      name = "power_capacity_watts"
    {% endif %}
  {% endif %}

{% endif %}
{% endfor %}
