# Copy this file to .env and change every secret before running generate.sh.

# InfluxDB is bound to 127.0.0.1:8086 by default in docker-compose.yaml, so
# only Grafana and Telegraf (on the same Compose network) can reach it. See
# the comment above the influxdb "ports" entry if you need to expose it.

# InfluxDB bootstrap account.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=CHANGE_ME_INFLUX_ADMIN_PASSWORD

# InfluxDB organization, bucket, retention, and API token.
INFLUX_ORG=netops
INFLUX_BUCKET=firewalls
INFLUX_RETENTION=30d
INFLUX_TOKEN=CHANGE_ME_LONG_RANDOM_INFLUX_TOKEN

# Grafana local administrator.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# Optional Palo Alto XML API keys are added here by paloalto_api_key.py.
# firewalls.yml references them as ${VARIABLE_NAME}; do not commit either
# local file. Direct YAML storage remains available with --storage yaml.
PALOALTO_API_KEY_PA_440=CHANGE_ME_PALO_ALTO_API_KEY

# Optional firewall inventory secrets referenced from firewalls.yml as
# ${VARIABLE_NAME}. Names are free; remove the ones you do not use.
# Docker Compose also reads this file and expands "$" in unquoted values:
# wrap a secret that contains "$" in single quotes, e.g. NAME='abc$def'.
# generate.py copies only the secrets Telegraf needs into the protected
# telegraf/paloalto-api.env; do not edit that generated file.
PA_440_SNMP_AUTH=CHANGE_ME_AUTH_PASSWORD
PA_440_SNMP_PRIV=CHANGE_ME_PRIV_PASSWORD
PA_440_SNMP_COMMUNITY=CHANGE_ME_COMMUNITY
FGT_80F_SNMP_AUTH=CHANGE_ME_AUTH_PASSWORD
FGT_80F_SNMP_PRIV=CHANGE_ME_PRIV_PASSWORD
FGT_80F_SNMP_COMMUNITY=CHANGE_ME_COMMUNITY
