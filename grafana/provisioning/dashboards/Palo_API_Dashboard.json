          },
          "query": "global = from(bucket: \"firewalls\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pan_system\" and r.hostname == \"${hostname}\" and (r._field == \"mp_cpu_pct\" or r._field == \"dp_cpu_pct\"))\n  |> map(fn: (r) => ({ r with _field: if r._field == \"mp_cpu_pct\" then \"Global MP\" else \"Global DP\" }))\nprocessors = from(bucket: \"firewalls\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"pan_hr_processors\" and r.hostname == \"${hostname}\" and r._field == \"processor_load_pct\")\n  |> map(fn: (r) => ({ r with _field: \"Processor \" + string(v: r.device_index) }))\nunion(tables: [global, processors])\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])",
          "refId": "A"
        }
      ],
      "title": "Global and All SNMP Processor CPU",
      "type": "timeseries",
      "description": "Global MP/DP CPU plus every processor exposed by pan_hr_processors. This helps reveal imbalance or a saturated processor/dataplane."
