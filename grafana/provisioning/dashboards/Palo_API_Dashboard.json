          },
          "query": "from(bucket: \"firewalls\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"interfaces\" and r.hostname == \"${hostname}\" and exists r.ifName and r.ifName !~ /(?i)^(mgmt|management|aux|hsci|ha($|[0-9-]))/ and r.ifName !~ /\\./ and r._field =~ /^ifHC(In|Out)Octets$/)\n  |> derivative(unit: 1s, nonNegative: true)\n  |> map(fn: (r) => ({ r with _value: r._value * 8.0, _field: if r._field == \"ifHCInOctets\" then \"In\" else \"Out\" }))\n  |> group(columns: [\"_time\", \"_field\"])\n  |> sum()\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "Interface Throughput (SNMP Octet Counters)",
      "type": "timeseries",
      "description": "Throughput intentionally comes from ifHCInOctets/ifHCOutOctets. API session throughput can miss offloaded or bypassed traffic."
